# Скопируй этот файл в .env и заполни реальными значениями.
# .env НЕ должен попадать в git (см. .gitignore) и не копируется в
# Docker-образ (см. .dockerignore) - только пробрасывается в контейнер
# через docker-compose.yml.

# --- Intraservice ---
INTRASERVICE_BASE_URL=https://sd.*****.com
INTRASERVICE_LOGIN=your_login
INTRASERVICE_PASSWORD=your_password

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token

# Кому разрешено пользоваться ботом. Через запятую, без пробелов.
# Узнать свой user_id можно через @userinfobot.
# Пустое или некорректное значение запрещает запуск бота.
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# --- Параметры парсера ---
# Значения по умолчанию уже есть в src/ispano/settings.py, но можно переопределить здесь.
REQUEST_DELAY=0.4
REQUEST_CONNECT_TIMEOUT=10
REQUEST_READ_TIMEOUT=30
MAX_PAGES_SAFETY=20
DEFAULT_LOOKBACK_HOURS=24
INTRASERVICE_TIMEZONE=Europe/Moscow
# Локальные экспорты сохраняются в <корень проекта>/exports.
# docker-compose автоматически переопределяет это значение на /app/exports.
OUTPUT_DIR=exports
# Эти файлы хранятся локально и не входят в Git/Docker-образ.
PARTNER_ALIASES_PATH=.local/partner_aliases.json
CUSTOMER_NAMES_PATH=.local/customer_names.json

# --- ИИ-суммаризация для `ispano tickets` ---
# Если URL или модель не заданы, суммаризация отключена.
TICKET_SUMMARY_API_BASE_URL=http://localhost:20128/v1
TICKET_SUMMARY_MODEL=
# Необязателен для локальных endpoint; при указании передаётся как Bearer-токен.
TICKET_SUMMARY_API_KEY=

# --- GigaChat для ИИ-суммаризации ---
# Оставьте generic для OpenAI-совместимого endpoint выше. Для GigaChat укажите gigachat:
# TICKET_SUMMARY_PROVIDER=gigachat
# TICKET_SUMMARY_API_BASE_URL=https://api.giga.chat/v1
# TICKET_SUMMARY_MODEL=GigaChat
# Это authorization key из личного кабинета GigaChat, а не временный OAuth access token.
# TICKET_SUMMARY_GIGACHAT_AUTHORIZATION_KEY=
# GIGACHAT_API_PERS — физлицо; для ИП/юрлиц задайте выданный вам scope.
# TICKET_SUMMARY_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Обычно менять не требуется.
# TICKET_SUMMARY_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# false отключает проверку сертификатов ТОЛЬКО для GigaChat. Используйте лишь если
# доверенный сертификат Минцифры нельзя установить в ОС/контейнере.
# TICKET_SUMMARY_GIGACHAT_VERIFY_SSL=true

# --- Защищённый веб-интерфейс ---
# Сгенерируйте bcrypt-хеш, например:
# poetry run python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
WEB_USERNAME=admin
WEB_PASSWORD_HASH=
# Не менее 32 случайных символов; например, `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
WEB_SESSION_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8000
