# Скопируй этот файл в .env и заполни реальными значениями.
# .env НЕ должен попадать в git (см. .gitignore) и не копируется в
# Docker-образ (см. .dockerignore) - только пробрасывается в контейнер
# через docker-compose.yml.

# --- Intraservice ---
INTRASERVICE_BASE_URL=https://sd.*****.com
INTRASERVICE_LOGIN=your_login
INTRASERVICE_PASSWORD=your_password

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token

# Кому разрешено пользоваться ботом. Через запятую, без пробелов.
# Узнать свой user_id можно через @userinfobot.
# Пустое или некорректное значение запрещает запуск бота.
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# --- Параметры парсера ---
# Значения по умолчанию уже есть в src/ispano/settings.py, но можно переопределить здесь.
REQUEST_DELAY=0.4
REQUEST_CONNECT_TIMEOUT=10
REQUEST_READ_TIMEOUT=30
MAX_PAGES_SAFETY=20
DEFAULT_LOOKBACK_HOURS=24
INTRASERVICE_TIMEZONE=Europe/Moscow
# Локальные экспорты сохраняются в <корень проекта>/exports.
# docker-compose автоматически переопределяет это значение на /app/exports.
OUTPUT_DIR=exports
